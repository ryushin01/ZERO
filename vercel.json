{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "feat/**": false,
      "fix/**": false,
      "docs/**": false,
      "chore/**": false,
      "content/**": false
    }
  },
  "headers": [
    {
      "source": "/art/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/storybook",
      "destination": "/storybook/index.html",
      "permanent": false
    },
    {
      "source": "/storybook/",
      "destination": "/storybook/index.html",
      "permanent": false
    }
  ]
}
