{
  "name": "zero",
  "version": "0.12.0",
  "private": true,
  "description": "Ark의 신과 영웅 133명을 카드로 쓰는 순수 자바스크립트 신화 덱빌딩 게임",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && storybook build -o dist/storybook --quiet",
    "preview": "vite preview --port 4173",
    "sync:ark": "node scripts/sync-ark.mjs",
    "lint": "eslint .",
    "lint:fsd": "steiger ./src",
    "check": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "imports": {
    "#app/*": "./src/app/*",
    "#pages/*": "./src/pages/*",
    "#widgets/*": "./src/widgets/*",
    "#features/*": "./src/features/*",
    "#entities/*": "./src/entities/*",
    "#shared/*": "./src/shared/*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/html-vite": "10.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "steiger": "0.10.0",
    "storybook": "10.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/familjen-grotesk": "5.3.0"
  }
}
