{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "#app/*": ["./src/app/*"],
      "#pages/*": ["./src/pages/*"],
      "#widgets/*": ["./src/widgets/*"],
      "#features/*": ["./src/features/*"],
      "#entities/*": ["./src/entities/*"],
      "#shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/**/*.js"],
  "exclude": ["src/**/*.test.js", "src/**/*.stories.js"]
}
